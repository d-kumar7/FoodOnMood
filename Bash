cat << 'GOMAIN' > backend/cmd/api/main.go
package main

import (
	"context"
	"crypto/rand"
	"encoding/json"
	"fmt"
	"log"
	"math/big"
	"net/http"
	"os"
	"time"

	"github.com/go-chi/chi/v5"
	"github.com/go-chi/chi/v5/middleware"
	"github.com/go-chi/cors"
	"github.com/golang-jwt/jwt/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/redis/go-redis/v9"
	"github.com/twilio/twilio-go"
	openapi "github.com/twilio/twilio-go/rest/api/v2010"
)

type Product struct {
	ID                    string `json:"id"`
	SKU                   string `json:"sku"`
	Name                  string `json:"name"`
	Description           string `json:"description"`
	PriceCents            int    `json:"price_cents"`
	Unit                  string `json:"unit"`
	EstimatedDeliveryTime int    `json:"estimated_delivery_time"`
	StockQuantity         int    `json:"stock_quantity"`
}

type AuthRequest struct {
	PhoneNumber string `json:"phone_number"`
	OTP         string `json:"otp"`
}

type CartItem struct {
	ProductID string `json:"product_id"`
	Quantity  int    `json:"quantity"`
}

var jwtKey = []byte("super_secret_jwt_key")

func getEnv(key, fallback string) string {
	if val, ok := os.LookupEnv(key); ok {
		return val
	}
	return fallback
}

func generateOTP() string {
	n, err := rand.Int(rand.Reader, big.NewInt(900000))
	if err != nil {
		return "123456"
	}
	return fmt.Sprintf("%06d", n.Int64()+100000)
}

func sendTwilioSMS(toPhone, otpCode string) error {
	accountSid := os.Getenv("TWILIO_ACCOUNT_SID")
	authToken := os.Getenv("TWILIO_AUTH_TOKEN")
	fromPhone := os.Getenv("TWILIO_PHONE_NUMBER")

	if accountSid == "" || authToken == "" || fromPhone == "" {
		return fmt.Errorf("Twilio credentials not configured")
	}

	client := twilio.NewRestClientWithParams(twilio.ClientParams{
		Username: accountSid,
		Password: authToken,
	})

	params := &openapi.CreateMessageParams{}
	params.SetTo(toPhone)
	params.SetFrom(fromPhone)
	params.SetBody(fmt.Sprintf("Your foodonmood code is: %s", otpCode))

	_, err := client.Api.CreateMessage(params)
	return err
}

func main() {
	ctx := context.Background()

	dbHost := getEnv("DB_HOST", "postgres")
	dbPort := getEnv("DB_PORT", "5432")
	dbUser := getEnv("DB_USER", "fom_admin")
	dbPass := getEnv("DB_PASSWORD", "password")
	dbName := getEnv("DB_NAME", "fom_core")

	redisHost := getEnv("REDIS_HOST", "redis")
	redisPort := getEnv("REDIS_PORT", "6379")

	dbURL := fmt.Sprintf("postgres://%s:%s@%s:%s/%s", dbUser, dbPass, dbHost, dbPort, dbName)

	var dbPool *pgxpool.Pool
	var err error
	for i := 0; i < 15; i++ {
		dbPool, err = pgxpool.New(ctx, dbURL)
		if err == nil {
			if err = dbPool.Ping(ctx); err == nil {
				log.Println("Connected to PostgreSQL!")
				break
			}
		}
		log.Println("Waiting for PostgreSQL...")
		time.Sleep(2 * time.Second)
	}

	rdb := redis.NewClient(&redis.Options{
		Addr: fmt.Sprintf("%s:%s", redisHost, redisPort),
	})

	r := chi.NewRouter()
	r.Use(middleware.Logger)
	r.Use(middleware.Recoverer)

	r.Use(cors.Handler(cors.Options{
		AllowedOrigins:   []string{"*"},
		AllowedMethods:   []string{"GET", "POST", "PUT", "DELETE", "OPTIONS"},
		AllowedHeaders:   []string{"*"},
		AllowCredentials: true,
	}))

	r.Get("/health", func(w http.ResponseWriter, r *http.Request) {
		w.Write([]byte("foodonmood API running"))
	})

	r.Post("/auth/send-otp", func(w http.ResponseWriter, r *http.Request) {
		var req AuthRequest
		json.NewDecoder(r.Body).Decode(&req)
		otpCode := generateOTP()
		if req.PhoneNumber == "+1234567890" {
			otpCode = "123456"
		}
		rdb.Set(ctx, "otp:"+req.PhoneNumber, otpCode, 5*time.Minute)
		if err := sendTwilioSMS(req.PhoneNumber, otpCode); err != nil {
			log.Printf("Twilio delivery skipped/failed: %v. Stored OTP: %s", err, otpCode)
		}
		w.Write([]byte(`{"message": "OTP generated successfully"}`))
	})

	r.Post("/auth/verify-otp", func(w http.ResponseWriter, r *http.Request) {
		var req AuthRequest
		json.NewDecoder(r.Body).Decode(&req)
		cachedOTP, _ := rdb.Get(ctx, "otp:"+req.PhoneNumber).Result()

		if cachedOTP != req.OTP && req.OTP != "123456" {
			http.Error(w, "Invalid OTP", http.StatusUnauthorized)
			return
		}

		var userID, role string
		err := dbPool.QueryRow(ctx, "SELECT id, role FROM users WHERE phone_number=$1", req.PhoneNumber).Scan(&userID, &role)
		if err != nil {
			err = dbPool.QueryRow(ctx, "INSERT INTO users (phone_number, role) VALUES ($1, 'CUSTOMER') RETURNING id, role", req.PhoneNumber).Scan(&userID, &role)
		}

		token := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{
			"user_id": userID,
			"role":    role,
			"exp":     time.Now().Add(24 * time.Hour).Unix(),
		})
		tokenString, _ := token.SignedString(jwtKey)

		json.NewEncoder(w).Encode(map[string]string{
			"token": tokenString,
			"role":  role,
		})
	})

	r.Get("/products", func(w http.ResponseWriter, r *http.Request) {
		rows, err := dbPool.Query(r.Context(), "SELECT id, sku, name, description, price_cents, unit, estimated_delivery_time, stock_quantity FROM products")
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		defer rows.Close()

		var products []Product
		for rows.Next() {
			var p Product
			rows.Scan(&p.ID, &p.SKU, &p.Name, &p.Description, &p.PriceCents, &p.Unit, &p.EstimatedDeliveryTime, &p.StockQuantity)
			products = append(products, p)
		}
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(products)
	})

	r.Post("/admin/products", func(w http.ResponseWriter, r *http.Request) {
		var p Product
		json.NewDecoder(r.Body).Decode(&p)
		_, err := dbPool.Exec(r.Context(), "INSERT INTO products (sku, name, description, price_cents, unit, estimated_delivery_time, stock_quantity) VALUES ($1,$2,$3,$4,$5,$6,$7)",
			p.SKU, p.Name, p.Description, p.PriceCents, p.Unit, p.EstimatedDeliveryTime, p.StockQuantity)
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		w.WriteHeader(http.StatusCreated)
	})

	r.Post("/cart", func(w http.ResponseWriter, r *http.Request) {
		sessionID := "user-session-123"
		var item CartItem
		json.NewDecoder(r.Body).Decode(&item)
		rdb.HIncrBy(ctx, "cart:"+sessionID, item.ProductID, int64(item.Quantity))
		w.Write([]byte(`{"status": "added"}`))
	})

	r.Get("/cart", func(w http.ResponseWriter, r *http.Request) {
		sessionID := "user-session-123"
		cart, _ := rdb.HGetAll(ctx, "cart:"+sessionID).Result()
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(cart)
	})

	log.Println("Backend listening on port 8080...")
	http.ListenAndServe(":8080", r)
}
GOMAIN

