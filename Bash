cat << 'PAGE' > frontend/src/app/page.tsx
"use client";

import { useEffect, useState } from "react";

export default function App() {
  const [phone, setPhone] = useState("");
  const [otp, setOtp] = useState("");
  const [token, setToken] = useState<string | null>(null);
  const [role, setRole] = useState("CUSTOMER");
  const [otpSent, setOtpSent] = useState(false);

  const [products, setProducts] = useState<any[]>([]);
  const [cart, setCart] = useState<Record<string, string>>({});

  // New Product Form (Admin)
  const [sku, setSku] = useState("");
  const [name, setName] = useState("");
  const [price, setPrice] = useState(0);
  const [unit, setUnit] = useState("portion");
  const [deliveryTime, setDeliveryTime] = useState(30);

  const fetchState = () => {
    fetch("/api/products")
      .then((res) => res.json())
      .then((data) => setProducts(data || []));

    fetch("/api/cart")
      .then((res) => res.json())
      .then((data) => setCart(data || {}));
  };

  useEffect(() => {
    fetchState();
  }, []);

  const handleSendOtp = async () => {
    await fetch("/api/auth/send-otp", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ phone_number: phone }),
    });
    setOtpSent(true);
  };

  const handleVerifyOtp = async () => {
    const res = await fetch("/api/auth/verify-otp", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ phone_number: phone, otp }),
    });
    const data = await res.json();
    if (res.ok) {
      setToken(data.token);
      setRole(data.role);
    } else {
      alert("Verification Failed");
    }
  };

  const addToCart = async (sku: string) => {
    await fetch("/api/cart", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ product_id: sku, quantity: 1 }),
    });
    fetchState();
  };

  const handleAddProduct = async () => {
    await fetch("/api/admin/products", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        sku,
        name,
        description: "Freshly prepared",
        price_cents: price * 100,
        unit,
        estimated_delivery_time: Number(deliveryTime),
        stock_quantity: 100,
      }),
    });
    alert("Item added!");
    fetchState();
  };

  const cartTotalItems = Object.values(cart).reduce((a, b) => a + parseInt(b, 10), 0);

  return (
    <div style={{ padding: "40px", fontFamily: "sans-serif", maxWidth: "1000px", margin: "0 auto" }}>
      <header style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "20px" }}>
        <h1 style={{ color: "#ea580c", margin: 0 }}>🍲 foodonmood</h1>
        <div style={{ fontWeight: "bold" }}>🛒 Cart: {cartTotalItems} items</div>
      </header>

      {!token ? (
        <div style={{ border: "1px solid #ccc", padding: "20px", borderRadius: "8px", maxWidth: "400px" }}>
          <h2>📱 Phone Authentication</h2>
          {!otpSent ? (
            <div>
              <input placeholder="+1234567890 (Admin Phone)" value={phone} onChange={(e) => setPhone(e.target.value)} style={{ width: "100%", padding: "8px", marginBottom: "10px" }} />
              <button onClick={handleSendOtp} style={{ width: "100%", padding: "10px", backgroundColor: "#ea580c", color: "#fff", border: "none" }}>Send OTP</button>
            </div>
          ) : (
            <div>
              <input placeholder="Enter OTP (Use 123456)" value={otp} onChange={(e) => setOtp(e.target.value)} style={{ width: "100%", padding: "8px", marginBottom: "10px" }} />
              <button onClick={handleVerifyOtp} style={{ width: "100%", padding: "10px", backgroundColor: "#10b981", color: "#fff", border: "none" }}>Verify OTP</button>
            </div>
          )}
        </div>
      ) : (
        <div>
          <p>Logged in as: <strong>{phone}</strong> (Role: <span style={{ color: "#ea580c", fontWeight: "bold" }}>{role}</span>)</p>

          {role === "ADMIN" && (
            <div style={{ border: "2px solid #ea580c", padding: "20px", borderRadius: "8px", marginBottom: "20px" }}>
              <h3>🛠 Admin Portal: Add Product</h3>
              <input placeholder="SKU" onChange={(e) => setSku(e.target.value)} style={{ marginRight: "10px" }} />
              <input placeholder="Name" onChange={(e) => setName(e.target.value)} style={{ marginRight: "10px" }} />
              <input type="number" placeholder="Price ($)" onChange={(e) => setPrice(Number(e.target.value))} style={{ marginRight: "10px" }} />
              <button onClick={handleAddProduct} style={{ padding: "8px 16px", backgroundColor: "#ea580c", color: "#fff", border: "none" }}>Add Item</button>
            </div>
          )}

          <h2>🍽 Menu Catalog</h2>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))", gap: "20px" }}>
            {products.map((p) => (
              <div key={p.id} style={{ border: "1px solid #ccc", padding: "15px", borderRadius: "8px" }}>
                <h3>{p.name}</h3>
                <p>${(p.price_cents / 100).toFixed(2)} / {p.unit}</p>
                <button onClick={() => addToCart(p.sku)} style={{ backgroundColor: "#ea580c", color: "#fff", border: "none", padding: "6px 12px" }}>Add to Cart</button>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
